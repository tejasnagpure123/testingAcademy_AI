APP_NAME=Jira QA Crew
APP_ENV=development
OUTPUT_DIR=outputs

LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.1

JIRA_INTEGRATION_MODE=auto
JIRA_URL=https://your-domain.atlassian.net
JIRA_AUTH_MODE=basic
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_BEARER_TOKEN=
JIRA_API_VERSION=3
JIRA_ACCEPTANCE_CRITERIA_FIELD=
JIRA_INCLUDE_COMMENTS=false
JIRA_MAX_COMMENTS=20

JIRA_MCP_TRANSPORT=streamable_http
JIRA_MCP_URL=
JIRA_MCP_COMMAND=
JIRA_MCP_ARGS_JSON=[]
JIRA_MCP_HEADERS_JSON={}
JIRA_MCP_GET_ISSUE_TOOL=
JIRA_MCP_ISSUE_ARGUMENT=issue_key
JIRA_MCP_TIMEOUT_SECONDS=20

PIPELINE_MAX_TICKETS=20
PIPELINE_MAX_RETRIES=2
PIPELINE_TICKET_TIMEOUT_SECONDS=600
PIPELINE_MAX_INPUT_CHARS=5000
JIRA_KEY_PATTERN=^[A-Z][A-Z0-9_]*-\d+$
LOG_LEVEL=INFO
DEMO_MODE=false
