# ============================================================
# QABuddy.ai — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- LLM Configuration ---
# Choose: "gemini" or "openai"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Model names
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# --- Qdrant Vector Database ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION_NAME=qabuddy
QDRANT_PATH=./qdrant_data

# --- Embedding Model ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
USE_GPU=false
HYBRID_SEARCH_TOP_K=15
RERANK_TOP_K=5

# --- JIRA Integration ---
JIRA_BASE_URL=https://your-domain.atlassian.net/
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token-here
JIRA_JQL=project = QA ORDER BY updated DESC

# --- Data Paths ---
DATA_DIR=./data
SELENIUM_REPO_URL=https://github.com/PramodDutta/ATB13xSeleniumAdvanceFramework
PLAYWRIGHT_REPO_URL=https://github.com/PramodDutta/Advance-Playwright-Framework

# --- Application ---
API_HOST=0.0.0.0
API_PORT=8000
UI_PORT=8501
LOG_LEVEL=INFO

# --- Authentication ---
APP_PASSWORD=qabuddy2026
